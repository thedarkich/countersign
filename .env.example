# ===== Countersign settings =====
# Copy to .env only for initial setup; fill it in privately and never commit it.
# Never put the mainnet owner's private key here. TESTNET_OWNER_PK is a separate throwaway testnet owner.

# --- Network ---
NETWORK=testnet                       # testnet | mainnet: where team, batch and stage demo transactions go
BOUNTY_NETWORK=testnet                # where public bounty attempts go; mainnet only if BOT Chain staff said yes
BOTCHAIN_MAINNET_RPC=https://rpc.botchain.ai
BOTCHAIN_TESTNET_RPC=https://rpc.bohr.life
EXPLORER_URL_MAINNET=https://scan.botchain.ai
EXPLORER_URL_TESTNET=https://scan.bohr.life
CONTRACT_ADDRESS_MAINNET=
CONTRACT_ADDRESS_TESTNET=
# Pay token: USDT on mainnet, tUSDT on testnet. Use 0x0000000000000000000000000000000000000000 for native BOT.
PAY_TOKEN_MAINNET=0xaBabc7Ddc03e501d190C676BF3d92ef0e6e87a3C
PAY_TOKEN_TESTNET=0x75edC9335175Fc0552D51D48439F229c10420fe3
TIMELOCK_DELAY_SECONDS=120
# In base units: 15 USDT = 15000000 (6 decimals). For native BOT use 18 decimals.
INITIAL_DAILY_CAP=15000000

# --- Public addresses ---
OWNER_ADDRESS=                        # finance lead's MetaMask address
VENDOR1_PAYOUT=
VENDOR2_PAYOUT=
VENDOR3_PAYOUT=
ATTACKER_ADDRESS=                     # team-owned, used inside poisoned invoices
AGENT_GUARDED_ADDRESS=                # public address of AGENT_GUARDED_PK
AGENT_NAIVE_ADDRESS=                  # public address of AGENT_NAIVE_PK

# --- Keys (gas-only wallets) ---
DEPLOYER_PK=
AGENT_GUARDED_PK=
AGENT_NAIVE_PK=
TESTNET_OWNER_PK=                     # testnet only; mainnet owner uses MetaMask or the Foundry keystore "owner"

# --- Gas for agent keys (SPEC §3.6.1) ---
GAS_MODE=self                         # self | paymaster (only after BOT Chain confirms sponsorship on 677)
PAYMASTER_RPC=                        # endpoint BOT Chain gives us for pm_isSponsorable + zero-gas txs

# Runtime actions are disabled until explicitly enabled for an authorized run.
TRANSACTIONS_ENABLED=false

# --- AI ---
LLM_ENABLED=false
LLM_MAX_OUTPUT_TOKENS=1024
# User-selected gateway; current balance is about $2, authorized for small tests only.
# Prefer Flash for routine tests. Max is available for selective comparisons.
# Model alternatives share this gateway; they are not independent outage protection.
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_TEXT_MODEL=qwen/qwen3.8-flash
TOKENROUTER_FAST_MODEL=qwen/qwen3.8-flash
TOKENROUTER_VISION_MODEL=qwen/qwen3.8-flash
TOKENROUTER_STRONG_MODEL=qwen/qwen3.8-max
TOKENROUTER_FALLBACK_TEXT_MODEL=deepseek/deepseek-v4.1-flash
TOKENROUTER_FALLBACK_VISION_MODEL=     # disabled: deepseek/deepseek-v4-flash-vision-exp returned HTTP 401 in its image probe
# Direct-provider alternatives below are optional and currently unconfigured.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen-vl-max
QWEN_TEXT_MODEL=qwen-plus
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
GUARD_VERSION=v1                      # v1 | v2 (after the learning loop)
LLM_HOURLY_CALL_CAP=20                 # process-local hourly call ceiling; not a dollar budget

# --- App ---
ADMIN_TOKEN=                          # long random string; protects Inbox and Controls API
PUBLIC_BASE_URL=http://localhost:8000
BOUNTY_ENABLED=false                 # public launch requires organizer permission and funded AI usage
BATCH_ENABLED=false                  # enable only for an explicitly authorized paid batch
QUEUE_CAPACITY=60
DOMAIN=                               # e.g. 1-2-3-4.sslip.io on the VPS; empty = plain HTTP on :80
IP_HASH_SALT=
RATE_DEVICE_PER_MIN=3
RATE_DEVICE_PER_DAY=30
RATE_NICKNAME_PER_DAY=30
RATE_GLOBAL_PER_MIN=60

# --- Public Good lane (optional, Phase 6) ---
SEPOLIA_RPC=
SEPOLIA_CONTRACT_ADDRESS=
VENDOR1_PK=                           # only if ERC-8004 feedback needs the vendor's signature
VENDOR2_PK=
VENDOR3_PK=

# Read-only receipt recovery and explorer discovery (no signing).
INDEXER_ENABLED=true
INDEXER_INTERVAL_SECONDS=20
INDEXER_START_BLOCK_TESTNET=
INDEXER_START_BLOCK_MAINNET=
INDEXER_BLOCK_WINDOW=50000
INDEXER_OVERLAP_BLOCKS=128
INDEXER_LAG_BLOCKS=128
INDEXER_REQUEST_BUDGET=20
RECOVERY_BATCH_SIZE=20

# Offline comparison consumes paid calls; keep disabled under the tests-only allowance.
EVAL_ENABLED=false

# Free Scam Sniffer feed; 7-day publication delay. No premium API needed.
SCAM_SCREENING_ENABLED=true
SCAM_SNAPSHOT_MAX_AGE_SECONDS=172800
